{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droidmcp-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "DEVICE", "class_name": "Device" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Device"] }],
  // Per-IP limits (requests per 60s): phone connection attempts and MCP client requests.
  "ratelimits": [
    { "name": "AGENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CLIENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
  // Optional, beta: code mode at /d/<device>/code/mcp (the AI runs JavaScript that calls many tools at once).
  // Dynamic Workers need the Workers Paid plan, so it's off by default. To turn it on, add a comma after
  // the ratelimits list and uncomment:
  // "worker_loaders": [{ "binding": "LOADER" }],
  // Optional: make the relay private with `wrangler secret put AGENT_KEY`.
  // Optional: custom domain:  "routes": [{ "pattern": "relay.example.com", "custom_domain": true }]
}
